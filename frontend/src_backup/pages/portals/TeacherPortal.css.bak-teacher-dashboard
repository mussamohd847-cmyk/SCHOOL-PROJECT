/* Teacher navbar profile dropdown */
.tp-profile-menu {
  position: relative;
  flex-shrink: 0;
}
.tp-profile-trigger {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 10px;
  border: 1px solid #e6ecee;
  border-radius: 9px;
  background: #fff;
  color: #263d45;
  font: 600 12px Inter, Arial, sans-serif;
  cursor: pointer;
}
.tp-profile-initial {
  display: grid;
  place-items: center;
  width: 29px;
  height: 29px;
  border-radius: 50%;
  background: #e0f4f2;
  color: #168c9b;
  font-weight: 800;
}
.tp-profile-dropdown {
  position: absolute;
  z-index: 20;
  top: calc(100% + 8px);
  right: 0;
  width: 190px;
  padding: 6px;
  background: #fff;
  border: 1px solid #e6ecee;
  border-radius: 10px;
  box-shadow: 0 10px 28px #17313a18;
}
.tp-profile-dropdown button {
  display: block;
  width: 100%;
  padding: 11px 10px;
  border: 0;
  border-radius: 7px;
  background: transparent;
  color: #52666d;
  text-align: left;
  font: 500 12px Inter, Arial, sans-serif;
  cursor: pointer;
}
.tp-profile-dropdown button:hover,
.tp-profile-dropdown button.active {
  background: #eaf7f6;
  color: #13808b;
}
.tp-profile-details p {
  padding: 10px 0;
  border-bottom: 1px solid #edf1f2;
  color: #62767d;
}
.tp-profile-details strong {
  color: #203941;
}
@media(max-width:700px) {
  .tp-profile-trigger { gap: 5px; padding: 5px 7px; }
  .tp-profile-trigger > span:nth-child(2) { display: none; }
}
